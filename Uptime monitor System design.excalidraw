      "updated": 1780574271747,
      "link": null,
      "locked": false,
      "text": "1. User\n- @auth /auth (login/signup) - by email OTP codes\n- @users /users\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. User\n- @auth /auth (login/signup) - by email OTP codes\n- @users /users\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "SjPbv4zqGfdsdCuEfSqcx",
      "type": "text",
