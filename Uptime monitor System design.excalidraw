      "isDeleted": false,
      "boundElements": [],
      "updated": 1780574923832,
      "link": null,
      "locked": false,
      "text": "2. Website Urls\n- @urls /urls - manage the urls resources (GET, POST, etc)\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Website Urls\n- @urls /urls - manage the urls resources (GET, POST, etc)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
